# StoreOps Frontend Environment Variables
# Copy this file to .env.local for local development

# =============================================================================
# API Configuration
# =============================================================================

# Base API URL (without trailing slash)
VITE_API_URL=http://dev.localhost:8000

# WebSocket URL for real-time features
VITE_WS_URL=ws://dev.localhost:8000

# =============================================================================
# Application Configuration
# =============================================================================

# Application base path
VITE_BASE_PATH=/storeops

# Environment mode
VITE_APP_ENV=development

# Enable debug mode
VITE_DEBUG=true

# Session timeout in minutes (default: 480 = 8 hours)
VITE_SESSION_TIMEOUT=480

# =============================================================================
# Feature Flags
# =============================================================================

# Enable PWA features
VITE_ENABLE_PWA=true

# Enable Sentry error tracking
VITE_ENABLE_SENTRY=false

# Sentry DSN
VITE_SENTRY_DSN=

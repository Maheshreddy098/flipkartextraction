  },
  {
   "fieldname": "sync_watermark",
   "fieldtype": "Datetime",
   "label": "Last Incremental Sync At",
   "read_only": 1,
   "description": "Auto-updated after each successful background sync. Clear to force a 30-day catch-up on next run."
  },
  {
   "default": "7",
   "fieldname": "lookback_days",
   "fieldtype": "Int",
   "label": "Sync Lookback Days",
   "description": "Days subtracted from watermark on each sync. 7 covers peak-period FBA SLAs and SP-API eventual-consistency lag."
  },
  {
   "fieldname": "fba_sync_watermark",
   "fieldtype": "Date",
   "label": "Last FBA Shipment Sync Date",
   "read_only": 1,
   "description": "Auto-advanced only on a successful daily sync -- never advanced on failure, so the next run retries the same window instead of silently skipping it. Clear to force a fresh INCREMENTAL_LOOKBACK_DAYS catch-up."
  },
  {
   "fieldname": "section_break_posting_safety",
   "fieldtype": "Section Break",
   "label": "Posting Safety"
  },
  {
   "default": "2026-06-01",
   "fieldname": "posting_cutoff_date",
   "fieldtype": "Date",
   "label": "Posting Cutoff Date",
   "description": "Invoices, credit notes and retries are refused for any order shipped (or purchased, if unshipped) before this date. Set past the last date Finance booked manually in SAP from the MTR report, so this pipeline can never duplicate it — SAP's NumAtCard dedup only catches orders this system posted itself."
  },
  {
   "fieldname": "section_break_alerts",
   "fieldtype": "Section Break",
   "label": "Alerting"
  },
  {
   "fieldname": "alert_email",
   "fieldtype": "Data",
   "label": "Health Check Alert Email",
   "options": "Email",
   "description": "Daily health check emails here if a scheduled sync is stale or posted orders are piling up without a ship date. Leave blank to disable."
  }
